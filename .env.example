# ローカル開発用の設定例。コピーして .env にする。
# .env は git に入れない（.gitignore 済み）。

# 空にすると Firestore を使わず、プロセス内メモリの台帳で動く。
# 開発中はこれでよい。**本番では必ず設定する**（/api/healthz の
# ledger_backend が memory のままだと全体上限が効かない）。
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-northeast1
FIRESTORE_DATABASE=(default)

# エージェント層（W4）で使う。W1 の時点では呼ばれない。
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# 求解。ワーカー数は Cloud Run に割り当てた vCPU と揃える。
SOLVE_TIME_LIMIT_S=60
SOLVE_WORKERS=8

# 暴走対策（USD）
MAX_USD_PER_REQUEST=0.10
DAILY_USD_PER_SUBJECT=0.50
DAILY_USD_GLOBAL=2.00

# Gemini は必ず global で呼ぶ。us-central1 では 404 になる（2026-09-03 実機確認）
GOOGLE_GENAI_LOCATION=global

# 全体の1か月上限。**予算アラートは通知するだけで支出を止めない。**
# 実際に止まるのはここ。$15.00（約2,250円）は、過去に ADK の暴走で一度に
# 失った額（2万数千円）の10分の1以下という水準で置いてある。
MONTHLY_USD_GLOBAL=15.00
